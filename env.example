# X API auth (set one)
X_OAUTH_ACCESS_TOKEN= [generate using generate_authtoken.py]
X_BEARER_TOKEN=

# X API settings
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT=30
X_API_DEBUG=1

# MCP server settings
MCP_HOST=127.0.0.1
MCP_PORT=8000

# FastMCP parser flag (optional)
FASTMCP_EXPERIMENTAL_ENABLE_NEW_OPENAPI_PARSER=

# Tool filtering (optional, comma-separated)
X_API_TOOL_TAGS=
X_API_TOOL_ALLOWLIST=
X_API_TOOL_DENYLIST=

# Local Grok client (optional)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast
MCP_SERVER_URL=[your ngrok url]/mcp 

# OAuth token generation (optional)
CLIENT_ID=
CLIENT_SECRET=
